                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"recipeId\", json.id);",
                  "pm.test(\"Score = 50 (1 ingredient disponible sur 2)\", function () { pm.expect(json.scorePourcentage).to.eql(50); });",
                  "pm.test(\"Etapes triees par ordre\", function () { pm.expect(json.steps[0].ordre).to.eql(1); });"
                ]
