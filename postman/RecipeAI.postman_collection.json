              "mode": "raw",
              "raw": "{\n  \"titre\": \"Salade test\",\n  \"description\": \"Salade simple\",\n  \"duree\": 10,\n  \"userId\": {{userId}},\n  \"ingredients\": [\n    {\n      \"ingredientId\": {{ingredientId}},\n      \"quantite\": 2,\n      \"disponible\": true\n    },\n    {\n      \"ingredientId\": {{ingredientId2}},\n      \"quantite\": 1,\n      \"disponible\": false\n    }\n  ],\n  \"steps\": [\n    {\n      \"ordre\": 1,\n      \"instruction\": \"Couper les legumes\"\n    },\n    {\n      \"ordre\": 2,\n      \"instruction\": \"Assaisonner\"\n    }\n  ]\n}",
              "options": {
