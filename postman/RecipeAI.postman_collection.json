      "name": "1 - user-service",
      "item": [
        {
          "name": "POST /users - creer un utilisateur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test User\",\n  \"email\": \"user{{$timestamp}}@test.com\",\n  \"motDePasse\": \"motdepasse123\",\n  \"regime\": \"vegetarien\",\n  \"allergies\": [\n    \"arachides\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"userId\", json.id);",
                  "pm.collectionVariables.set(\"userEmail\", json.email);",
                  "pm.test(\"Role USER attribue par le service\", function () { pm.expect(json.role).to.eql(\"USER\"); });",
                  "pm.test(\"Mot de passe absent de la reponse\", function () { pm.expect(json).to.not.have.property(\"motDePasse\"); });"
                ]
              }
            }
          ]
        },
