    {
      "name": "1 - user-service",
      "item": [
        {
          "name": "Créer un utilisateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);",
                  "pm.test(\"Role USER, sans mot de passe\", function () { var j = pm.response.json(); pm.expect(j.role).to.eql(\"USER\"); pm.expect(j).to.not.have.property(\"motDePasse\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"userEmail\", \"user\" + Date.now() + \"@test.com\");",
                  "pm.collectionVariables.set(\"ingName1\", \"Tomate-\" + Date.now());",
                  "pm.collectionVariables.set(\"ingName2\", \"Oignon-\" + Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Rihab\",\n  \"email\": \"{{userEmail}}\",\n  \"motDePasse\": \"12345678\",\n  \"regime\": \"vegetarien\",\n  \"allergies\": [\n    \"arachides\"\n  ]\n}"
